#!/bin/sh
# Synchronizacja OneDrive na żądanie: uruchamia tę samą usługę co timer
# (te same ustawienia, blokada i log), a potem streszcza wynik z logu.
unit="${ONEDRIVE_SYNC_UNIT:-onedrive-bisync.service}"
log="${ONEDRIVE_SYNC_LOG:-$HOME/.local/state/rclone-bisync.log}"

before=$(wc -l < "$log" 2>/dev/null || echo 0)
echo "OneDrive: synchronizuję..."
systemctl --user start "$unit"
rc=$?

# Wpisy logu z tego uruchomienia (log mógł zostać zrotowany -> wtedy cały nowy plik)
after=$(wc -l < "$log" 2>/dev/null || echo 0)
[ "$after" -lt "$before" ] && before=0
new=$(tail -n +"$((before + 1))" "$log" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')

if [ "$rc" -eq 0 ]; then
    echo "✅ Synchronizacja OK ($(date +%H:%M:%S))"
    sent=$(printf '%s\n' "$new" | grep -E ': (Copied|Deleted)' | sed -E 's/^.*INFO  : //')
    if [ -n "$sent" ]; then
        echo "Przesłane zmiany:"
        printf '%s\n' "$sent" | sed 's/^/  - /'
    else
        echo "Brak zmian do przesłania."
    fi
    conflicts=$(printf '%s\n' "$new" | grep 'Renaming Path. copy' | sed -E 's/.*Renaming Path. copy +- //')
    if [ -n "$conflicts" ]; then
        echo "⚠️  Konflikt: wersja z chmury przegrała z lokalną i została zachowana jako:"
        printf '%s\n' "$conflicts" | sed 's/^/  - /'
    fi
else
    echo "❌ Synchronizacja nieudana (systemctl rc=$rc)."
    errs=$(printf '%s\n' "$new" | grep -E 'ERROR|CRITICAL|Failed' | tail -n 10)
    if [ -n "$errs" ]; then
        printf '%s\n' "$errs"
    else
        journalctl --user -u "$unit" -n 5 --no-pager -q
    fi
    echo "Pełny log: $log"
fi
exit "$rc"
